{
  "name": "shopify-chatwoot-sync",
  "version": "1.0.0",
  "description": "Syncs Shopify customer and order data to Chatwoot contacts",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:web": "cd web && npm install && npm run build",
    "build:server": "tsc",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.js",
    "backfill": "tsx src/scripts/backfillOpenConversations.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "axios": "^1.13.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
