SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id_from_dev_dashboard
SHOPIFY_CLIENT_SECRET=shpss_your_client_secret
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=your_chatwoot_api_access_token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
SYNC_API_KEY=generate_a_random_secret_here
SYNC_INTERVAL_HOURS=6
PORT=8080

# AI Draft Auto-Reply
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
CLAUDE_SYSTEM_PROMPT=You are a helpful customer support assistant...
CLAUDE_MODEL=claude-sonnet-4-20250514
# Cheaper model for the per-message conversation classifier (labels + routing)
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5
# Optional override for the autonomous AgentBot responder system prompt
# (defaults to src/config/responderPrompt.txt)
CLAUDE_RESPONDER_PROMPT=
SEVENTEENTRACK_API_KEY=your_17track_api_key
CHATWOOT_WEBHOOK_SECRET=optional_secret_for_webhook_url
# Optional shared secret for the AgentBot webhook (?secret=... query param)
CHATWOOT_AGENT_BOT_SECRET=optional_secret_for_agent_bot_url
# Send a holding reply to the customer on escalation (true/false, default true).
# When false, escalations are silent: the bot just hands off to a human (sets the
# conversation open) and generates a draft, without messaging the customer.
AGENT_BOT_HOLDING_REPLY=true

# Skio (subscriptions) — used by the Chatwoot Dashboard App
SKIO_API_KEY=your_skio_api_key

# Chatwoot Dashboard App
# Gate /app and /app/api/* — pass as ?token= in the Chatwoot Dashboard App URL.
# Example: https://<your-domain>/app?token=<this value>
DASHBOARD_APP_TOKEN=generate_a_random_secret_here

# Firebase / Firestore — stores AI customer summaries.
# Base64 of the service account JSON: base64 -w0 service-acc.json
# If unset, summaries are generated but not persisted (read/write is skipped).
FIREBASE_BASE64_SERVICE_ACCOUNT=base64_encoded_service_account_json
